{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Персонаж Инфузии",
 "type": "object",
 "required": [
  "schema",
  "identity",
  "rank",
  "class",
  "stats",
  "skills",
  "abilities",
  "equipment",
  "implants",
  "pockets"
 ],
 "properties": {
  "schema": {
   "const": "infusion-character/1"
  },
  "identity": {
   "type": "object",
   "properties": {
    "name": {},
    "player": {},
    "gender": {},
    "age": {},
    "height": {},
    "weight": {},
    "religion": {},
    "eyes": {},
    "skin": {},
    "notes": {}
   }
  },
  "trait": {
   "type": "string",
   "description": "id из rules/traits.json"
  },
  "rank": {
   "type": "string",
   "description": "id из rules/ranks.json"
  },
  "class": {
   "type": "string"
  },
  "essence": {
   "type": [
    "string",
    "null"
   ],
   "description": "id из rules/essences.json"
  },
  "stats": {
   "type": "object",
   "required": [
    "strength",
    "dexterity",
    "intelligence",
    "will",
    "charisma",
    "perception",
    "technique",
    "luck",
    "constitution"
   ],
   "additionalProperties": {
    "type": "integer",
    "minimum": 0,
    "maximum": 10
   }
  },
  "overrides": {
   "type": "object",
   "description": "Ручные значения. null = считать по формуле.",
   "properties": {
    "freePoints": {
     "type": [
      "integer",
      "null"
     ]
    },
    "hpMax": {
     "type": [
      "integer",
      "null"
     ]
    },
    "kronosMax": {
     "type": [
      "integer",
      "null"
     ]
    },
    "sellPrice": {
     "type": "object",
     "description": "id предмета → цена"
    },
    "skillShards": {
     "type": "object",
     "description": "id навыка → щепки"
    }
   }
  },
  "skills": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "skill"
    ],
    "properties": {
     "skill": {
      "type": "string"
     },
     "level": {
      "type": "integer",
      "minimum": 0
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "abilities": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "ref"
    ],
    "properties": {
     "ref": {
      "type": "string"
     },
     "slot": {
      "type": "integer"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "implantCapacity": {
   "type": "object",
   "properties": {
    "base": {
     "type": "number"
    },
    "bonus": {
     "type": "number"
    }
   }
  },
  "equipment": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item"
    ],
    "properties": {
     "item": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "implants": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item"
    ],
    "properties": {
     "item": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "pockets": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item"
    ],
    "properties": {
     "item": {
      "type": "string"
     },
     "qty": {
      "type": "integer",
      "minimum": 1
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "repository": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "card"
    ],
    "properties": {
     "card": {
      "type": "string"
     },
     "qty": {
      "type": "integer",
      "minimum": 1
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}