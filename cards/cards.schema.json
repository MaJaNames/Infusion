{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Карты",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "id",
   "name",
   "rarity",
   "kronos",
   "priceTali"
  ],
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^[a-z0-9-]+$"
   },
   "tag": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "rarity": {
    "type": "string",
    "enum": [
     "Обычный",
     "Необычный",
     "Редкий",
     "Эпический",
     "Легендарный"
    ]
   },
   "classes": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "school": {
    "type": "string"
   },
   "essence": {
    "type": [
     "string",
     "null"
    ]
   },
   "params": {
    "type": "string"
   },
   "damageType": {
    "type": [
     "string",
     "null"
    ]
   },
   "range": {
    "type": [
     "string",
     "null"
    ]
   },
   "trigger": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "effects": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "test": {
    "type": [
     "string",
     "null"
    ]
   },
   "mechanics": {
    "type": "string"
   },
   "amplify": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "consumable": {
    "type": "boolean"
   },
   "kronos": {
    "type": "integer"
   },
   "priceTali": {
    "type": "integer"
   },
   "creation": {
    "enum": [
     "Базис",
     "Модификатор"
    ]
   },
   "iconic": {
    "type": "boolean"
   }
  }
 }
}